{
  "extends": "./tsconfig.rslib.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src-demo/**/*"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "types": [
      "@rsbuild/core/types",
      "node"
    ],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.rsbuild.tsbuildinfo",
    "outDir": "demo"
  }
}