{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@logue/reverb",
  "version": "1.6.3",
  "description": "JavaScript Reverb effect class",
  "keywords": [
    "webaudio",
    "convolver",
    "effect",
    "reverb"
  ],
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "homepage": "https://github.com/logue/Reverb.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/Reverb.js.git"
  },
  "bugs": {
    "url": "https://github.com/logue/Reverb.js/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./umd": {
      "default": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.22.0",
  "sideEffects": false,
  "scripts": {
    "dev": "rslib --watch",
    "dev:demo": "rsbuild",
    "dev:storybook": "storybook dev -p 6006",
    "lint": "run-s lint:*",
    "lint:rslint": "rslint .",
    "lint:biome": "biome check --write",
    "build": "rslib build",
    "build:demo": "rsbuild build",
    "build:storybook": "storybook build --output-dir docs",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "clean": "rimraf dist demo docs",
    "clean:hard": "rimraf dist demo docs node_modules/.tmp node_modules/.cache",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "peerDependencies": {
    "@thi.ng/colored-noise": "^1",
    "@thi.ng/random": "^4",
    "@thi.ng/transducers": "^9.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@microsoft/api-extractor": "^7.58.13",
    "@rsbuild/core": "^2.1.13",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.8.1",
    "@rstest/adapter-rslib": "^0.11.9",
    "@rstest/core": "^0.11.9",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "mermaid": "^11.17.0",
    "npm-run-all2": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "storybook": "10.6.2",
    "storybook-addon-rslib": "^3.4.2",
    "storybook-html-rsbuild": "^3.4.2",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}