{
  "extends": "./tsconfig.rslib.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "stories/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/.*/",
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "docs",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "@rsbuild/core/types",
      "node"
    ],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.storybook.tsbuildinfo"
  }
}